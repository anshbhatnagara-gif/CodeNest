# CodeNest Free Academy - Backend Environment Variables
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=codenest
  
# JWT Security
JWT_SECRET=your_jwt_secret_key_here

# Owner Configuration (Admin Dashboard Access)
OWNER_EMAIL=anshbhatnagara@gmail.com

# Production URL Configuration (e.g. Vercel)
FRONTEND_URL=http://localhost:5173

# Notes Management Storage Configuration
MAX_NOTE_FILE_SIZE_MB=25

# Storage Provider Configuration ('r2' for Cloudflare R2, 'local' for local disk)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=codenest-attachments


